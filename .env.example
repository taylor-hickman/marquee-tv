# Every variable Marquee TV reads. Values live only in Vercel and GitHub
# Actions (architecture 9.2); set them with scripts/provision/wizard.sh.
#
# A "# @<stage> <targets>" line applies to the names below it, up to the next
# such line. <stage> is the wizard stage that sets them
# (scripts/provision/wizard.sh --only <stage>). <targets> are where they must
# exist, in both the preview and production environments:
#   vercel  the Vercel project's Preview and Production environments
#   github  the GitHub Actions environments "preview" and "production"
# scripts/provision/verify.sh reads these lines.
#
# Preview uses the Supabase staging project; production uses Supabase production.

# @supabase vercel
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# @supabase vercel github
DATABASE_URL=

# @stripe vercel
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PASS=
STRIPE_PRICE_MONTHLY=

# @sentry vercel
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# @google-cloud github
YOUTUBE_API_KEY=

# @llm vercel github
ANTHROPIC_API_KEY=

# A group with no targets lives in neither Vercel nor the Actions
# environments, and verify.sh skips it.

# Test-only, and not secret. ci.yml sets them for the e2e job: B1's fake LLM
# adapter, and the Stripe client pointed at stripe-mock (build plan 6.1).
# @test
LLM_ADAPTER=fake
STRIPE_API_BASE=http://localhost:12111

# GitHub Actions repository secret that preview-smoke.yml sends to reach
# protected preview deploys: the project's Protection Bypass for Automation.
# @vercel-bypass
VERCEL_AUTOMATION_BYPASS_SECRET=
